{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EdiMarkdown",
  "version": "3.4.0",
  "identifier": "io.github.edimarkweb",
  "build": {
    "beforeDevCommand": {
      "script": "npm run build:desktop",
      "wait": true
    },
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "EdiMarkdown",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https:; img-src 'self' asset: http://asset.localhost blob: data: https:; media-src 'self' blob: data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; font-src 'self' data:; frame-src 'self' https:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Editor Markdown con soporte LaTeX",
    "longDescription": "EdiMarkdown es un editor de Markdown con vista previa, fórmulas LaTeX y exportación a varios formatos.",
    "homepage": "https://edimarkweb.github.io/",
    "linux": {
      "deb": {
        "desktopTemplate": "desktop-entry.desktop"
      }
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "mimeType": "text/markdown",
        "name": "Documento Markdown",
        "description": "Documento Markdown",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

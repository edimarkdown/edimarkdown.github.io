{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Permite abrir y guardar los documentos del usuario y descargar las actualizaciones publicadas en GitHub.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "dialog:default",
    "opener:default",
    "clipboard-manager:allow-read-image",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-appconfig-read-recursive",
    "fs:allow-appconfig-write-recursive",
    "fs:allow-appconfig-meta-recursive",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.github.com/repos/edimarkdown/*" },
        { "url": "https://github.com/edimarkdown/*" }
      ]
    }
  ]
}
